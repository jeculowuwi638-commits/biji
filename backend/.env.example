# 本地运行配置：
# cd backend
# Copy-Item .env.example .env
# 数据库、账号需提前创建，见 README 第一节。

PORT=3000
NODE_ENV=development

# 本地 MySQL 8
DATABASE_URL=mysql://biji:biji_password@127.0.0.1:3306/biji

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=2.5h

# DeepSeek OpenAI 兼容接口。Key 只放在 .env，切勿提交到仓库。
# 只保留有 Key 的功能：留空时生成、档案分析和助手统一返回 503 NO_API_KEY。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# deepseek-v4-flash 是 V4.1-Flash 的兼容别名，官方当前名称是 deepseek-flash，二者可互换。
LLM_MODEL=deepseek-v4-flash
# DeepSeek V4 默认开启思考模式；写作任务不需要，关闭以降低延迟和费用。其他服务请留空。
LLM_THINKING=disabled
LLM_TIMEOUT_MS=90000
LLM_RETRIES=1

# 生成、档案分析和助手对话都实时调用模型；项目不再读写任何模型响应缓存。
