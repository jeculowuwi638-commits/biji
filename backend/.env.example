# 本地运行配置：
# cd backend
# Copy-Item .env.example .env
# 数据库、账号需提前创建，见 README 第一节。

PORT=3000
NODE_ENV=development

# 本地 MySQL 8
DATABASE_URL=mysql://biji:biji_password@127.0.0.1:3306/biji

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=2.5h

# DeepSeek OpenAI 兼容接口。Key 只放在 .env，切勿提交到仓库。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# deepseek-v4-flash 是 V4.1-Flash 的兼容别名，官方当前名称是 deepseek-flash，二者可互换。
LLM_MODEL=deepseek-v4-flash
# DeepSeek V4 默认开启思考模式；写作任务不需要，关闭以降低延迟和费用。其他服务请留空。
LLM_THINKING=disabled
LLM_TIMEOUT_MS=90000
LLM_RETRIES=1

# 仅档案语义分析读写缓存；生成/重写始终实时调用模型，不使用此文件。
# 默认指向 backend/data/llm_cache.json，一般不需要改
# LLM_CACHE_PATH=
